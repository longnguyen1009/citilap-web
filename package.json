{
  "name": "citilap-web2",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite dev --port 3001",
    "dev:next": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "dev:cloudflare": "vite dev --port 3001",
    "build:cloudflare": "vite build",
    "cf:typegen": "wrangler types --include-runtime=false",
    "cf:deploy": "node scripts/deploy-cloudflare.mjs",
    "db:generate": "prisma generate && node scripts/post-prisma-generate.mjs",
    "db:migrate:local": "wrangler d1 migrations apply citilap-db-dev --local",
    "db:migrate:remote": "wrangler d1 migrations apply citilap-db-dev --remote",
    "db:migrate:staging": "wrangler d1 migrations apply DB --env staging --remote",
    "db:migrate:prod": "wrangler d1 migrations apply DB --env production --remote",
    "db:query:local": "wrangler d1 execute citilap-db-dev --local",
    "db:seed:local": "wrangler d1 execute citilap-db-dev --local --file=scripts/seed-development.sql",
    "db:seed:demo": "node scripts/seed-storefront-demo.mjs --local",
    "test:storefront-improvements": "node scripts/test-storefront-improvements.mjs",
    "verify:cf": "node scripts/build-verify.mjs && wrangler dev scripts/verify-cf.mjs --port 8787",
    "postinstall": "node scripts/post-prisma-generate.mjs"
  },
  "dependencies": {
    "@libsql/client": "^0.17.4",
    "@prisma/adapter-d1": "^7.9.1",
    "@prisma/adapter-libsql": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@tiptap/extension-color": "^3.33.0",
    "@tiptap/extension-highlight": "^3.33.0",
    "@tiptap/extension-image": "^3.33.0",
    "@tiptap/extension-link": "^3.33.0",
    "@tiptap/extension-placeholder": "^3.33.0",
    "@tiptap/extension-table": "^3.33.0",
    "@tiptap/extension-table-cell": "^3.33.0",
    "@tiptap/extension-table-header": "^3.33.0",
    "@tiptap/extension-table-row": "^3.33.0",
    "@tiptap/extension-text-align": "^3.33.0",
    "@tiptap/extension-text-style": "^3.33.0",
    "@tiptap/extension-underline": "^3.33.0",
    "@tiptap/pm": "^3.33.0",
    "@tiptap/react": "^3.33.0",
    "@tiptap/starter-kit": "^3.33.0",
    "@vinext/cloudflare": "^1.0.1",
    "lucide-react": "^1.33.0",
    "next": "16.3.1",
    "prisma": "^7.9.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-server-dom-webpack": "19.2.8",
    "vinext": "^1.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1",
    "@cloudflare/workers-types": "^5.20261006.1",
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "6.1.2",
    "@vitejs/plugin-rsc": "0.5.35",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "8.3.3",
    "wrangler": "^4.147.0"
  },
  "type": "module"
}
