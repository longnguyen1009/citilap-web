{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "citilap-ecommerce",
  "main": "src/worker.ts",
  "images": { "binding": "IMAGES" },
  "triggers": { "crons": ["* * * * *"] },
  "compatibility_date": "2024-11-01",
  "compatibility_flags": [
    "nodejs_compat",
    "enable_weak_ref",
    "nodejs_compat_populate_process_env"
  ],
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "citilap-db-dev",
      "database_id": "932e3840-8062-49c9-8d4a-c6d0d33457ea",
      "migrations_dir": "d1-migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PRODUCT_MEDIA",
      "bucket_name": "citilap-media-dev"
    }
  ],
  "observability": {
    "enabled": true
  },
  "env": {
    "staging": {
      "images": { "binding": "IMAGES" },
      "name": "citilap-ecommerce-staging",
      "account_id": "8952957f4eed25a74e19a3e273c4a589",
      "vars": {
        "APP_ENV": "staging",
        "NEXT_PUBLIC_TURNSTILE_SITE_KEY": "0x4AAAAAAFZsbdPpsQAHD2eQ",
        "NEXT_PUBLIC_SITE_URL": "https://citilap-ecommerce-staging.restless-snowflake-aaae.workers.dev"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "citilap-db-staging",
          "database_id": "a812357f-51a3-4139-badf-2079bf2cd2e9",
          "migrations_dir": "d1-migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "PRODUCT_MEDIA",
          "bucket_name": "citilap-media-staging"
        }
      ]
    },
    "production": {
      "images": { "binding": "IMAGES" },
      "name": "citilap-ecommerce-prod",
      "vars": {
        "APP_ENV": "production",
        "NEXT_PUBLIC_SITE_URL": "https://citilap.vn"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "citilap-db-prod",
          "database_id": "PROD_D1_DB_ID_PLACEHOLDER",
          "migrations_dir": "d1-migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "PRODUCT_MEDIA",
          "bucket_name": "citilap-media-prod"
        }
      ]
    }
  }
}
