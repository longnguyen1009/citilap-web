generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
  runtime  = "cloudflare"
}

datasource db {
  provider = "sqlite"
}

model User {
  id         String   @id @default(cuid())
  email      String   @unique
  password   String
  name       String?
  phone      String?
  role       String   @default("USER") // USER, ADMIN
  tier       String   @default("Mới") // Vàng, Bạc, Mới
  totalSpend Int      @default(0) // Integer VND
  orders     Order[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Brand {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  logo        String?   // R2 media key or image path
  description String?
  seoTitle    String?
  seoDescription String?
  status      String    @default("ACTIVE") // ACTIVE, INACTIVE
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@index([status])
}

model Category {
  id            String     @id @default(cuid())
  name          String     @unique
  slug          String     @unique
  description   String?
  image         String?
  parentId      String?
  parent        Category?  @relation("CategoryToCategory", fields: [parentId], references: [id])
  subCategories Category[] @relation("CategoryToCategory")
  sortOrder     Int        @default(0)
  status        String     @default("ACTIVE") // ACTIVE, INACTIVE
  products      Product[]
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([parentId])
  @@index([status])
  @@index([sortOrder])
}

model Product {
  studio         ProductStudio?
  id             String           @id @default(cuid())
  name           String
  slug           String           @unique
  description    String
  shortDescription String?
  contentHtml    String?
  brand          String?          // Transitional string field for backward compatibility
  brandId        String?
  brandRel       Brand?           @relation(fields: [brandId], references: [id])
  model          String?
  series         String?
  warranty       String?
  condition      String           @default("NEW") // Stable code: NEW, LIKE_NEW, USED, REFURBISHED, LIQUIDATION
  origin         String?
  seoTitle       String?
  seoDescription String?
  canonicalSlug  String?
  isFeatured     Boolean          @default(false)
  isNewArrival   Boolean          @default(false)
  isFlashSale    Boolean          @default(false)
  isBestSeller   Boolean          @default(false)
  allowBackorder Boolean          @default(false)
  minOrderQty    Int              @default(1)
  maxOrderQty    Int?
  lowestPrice30d Int?             // Integer VND
  publishAt      DateTime?
  unpublishAt    DateTime?
  price          Int              // Integer VND
  originalPrice  Int?             // Integer VND
  images         String           @default("[]") // JSON string for backward compatibility
  stock          Int              @default(0) // Transitional aggregate until inventory system
  status         String           @default("ACTIVE") // Stable code: DRAFT, ACTIVE, INACTIVE, ARCHIVED
  
  // Filter-critical specification columns (Option A - optimized for D1 queries & index lookup)
  cpu            String?          // e.g. "Intel Core i7-13700H", "AMD Ryzen 7 7840HS"
  cpuSeries      String?          // e.g. "Core i5", "Core i7", "Core i9", "Ryzen 7", "Apple M3"
  gpu            String?          // e.g. "NVIDIA GeForce RTX 4060 8GB"
  gpuSeries      String?          // e.g. "RTX 4050", "RTX 4060", "RTX 4070", "RTX 4080", "Onboard"
  ram            String?          // e.g. "16GB DDR5"
  ramGb          Int?             // e.g. 8, 16, 32, 64
  storage        String?          // e.g. "512GB NVMe SSD"
  storageGb      Int?             // e.g. 512, 1024, 2048
  display        String?          // e.g. "15.6 inch FHD 144Hz"
  screenSize     Float?           // e.g. 14.0, 15.6, 16.0
  refreshRate    Int?             // e.g. 60, 120, 144, 165, 240
  
  specs          String?          // JSON string for full PDP specifications
  tags           String?          // Comma-separated string
  categoryId     String
  category       Category         @relation(fields: [categoryId], references: [id])
  variants       ProductVariant[]
  productImages  ProductImage[]
  editLogs       ProductEditLog[]
  versions       ProductVersion[]
  orderItems     OrderItem[]
  inventoryType  String           @default("SERIALIZED") // SERIALIZED, QUANTITY
  serialUnits    SerialUnit[]
  inventoryBalances InventoryBalance[]
  inventoryTransactions InventoryTransaction[]
  inventoryReservations InventoryReservation[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  deletedAt      DateTime?

  @@index([categoryId])
  @@index([brandId])
  @@index([status])
  @@index([condition])
  @@index([price])
  @@index([isFeatured])
  @@index([isNewArrival])
  @@index([isFlashSale])
  @@index([isBestSeller])
  @@index([createdAt])
  @@index([ramGb])
  @@index([cpuSeries])
  @@index([gpuSeries])
}

model ProductVariant {
  id            String    @id @default(cuid())
  productId     String
  product       Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku           String    @unique
  name          String
  options       String    // JSON string for variant config pairs
  price         Int       // Integer VND
  originalPrice Int?      // Integer VND
  stock         Int       @default(0) // Transitional aggregate
  image         String?
  status        String    @default("ACTIVE") // ACTIVE, INACTIVE
  
  // Specific variant config specs
  cpu           String?
  gpu           String?
  ram           String?
  storage       String?
  display       String?

  productImages         ProductImage[]
  serialUnits           SerialUnit[]
  inventoryBalances     InventoryBalance[]
  inventoryTransactions InventoryTransaction[]
  inventoryReservations InventoryReservation[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([productId])
  @@index([status])
}

model ProductImage {
  id        String          @id @default(cuid())
  productId String
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  r2Key     String          // Source of truth key in Cloudflare R2 bucket
  url       String?         // Public path or relative path (derived from r2Key if null)
  mimeType  String?         @default("image/webp")
  width     Int?
  height    Int?
  size      Int?            // Size in bytes
  alt       String?
  sortOrder Int             @default(0)
  isPrimary Boolean         @default(false)
  createdAt DateTime        @default(now())

  @@index([productId])
  @@index([variantId])
  @@index([r2Key])
  @@index([isPrimary])
  @@index([sortOrder])
}

model ProductEditLog {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  action     String
  actorName  String?
  snapshot   String?
  createdAt  DateTime @default(now())

  @@index([productId])
  @@index([createdAt])
}

model ProductVersion {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  version   Int
  data      String
  createdAt DateTime @default(now())

  @@unique([productId, version])
  @@index([productId])
}

model Order {
  id              String      @id @default(cuid())
  orderNumber     String?     @unique
  idempotencyKey  String?     @unique
  payloadHash     String?
  userId          String?
  user            User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  status          String      @default("NEW") // Stable status codes: NEW, CONTACTED, CONFIRMED, COMPLETED, CANCELLED
  revision        Int         @default(0) // Concurrency CAS version
  subtotalAmount  Int         @default(0) // Integer VND
  shippingFee     Int         @default(0) // Integer VND
  discountAmount  Int         @default(0) // Integer VND
  totalAmount     Int         @default(0) // Integer VND
  shippingAddress String?
  customerName    String
  customerPhone   String
  customerEmail   String?
  shippingMethod  String?     @default("standard")
  note            String?
  paymentMethod   String      @default("COD")
  paymentStatus   String      @default("PENDING")
  confirmationTokenHash String?
  items           OrderItem[]
  events          OrderEvent[]
  internalNotes   OrderNote[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  completedAt     DateTime?

  @@index([status])
  @@index([customerPhone])
  @@index([createdAt])
}

model OrderItem {
  id                  String      @id @default(cuid())
  orderId             String
  order               Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId           String
  product             Product     @relation(fields: [productId], references: [id])
  variantId           String?
  serialUnitId        String?
  serialUnit          SerialUnit? @relation(fields: [serialUnitId], references: [id], onDelete: SetNull)
  productName         String?
  sku                 String?
  productNameSnapshot String?
  skuSnapshot         String?
  variantNameSnapshot String?
  price               Int         // Integer VND price at the time of purchase
  priceSnapshot       Int?
  quantity            Int
  lineTotal           Int         @default(0)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  @@index([orderId])
  @@index([productId])
  @@index([serialUnitId])
}

model OrderEvent {
  id         String   @id @default(cuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  action     String   // CREATED, STATUS_CHANGE, NOTE_ADDED, CANCELLED, REOPENED
  fromStatus String?
  toStatus   String?
  reason     String?
  note       String?
  actor      String   @default("Hệ thống")
  createdAt  DateTime @default(now())

  @@index([orderId])
  @@index([createdAt])
}

model OrderNote {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  content   String
  actor     String   @default("Nhân viên vận hành")
  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([createdAt])
}

model Warehouse {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  status      String   @default("ACTIVE") // ACTIVE, INACTIVE
  address     String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  serialUnits           SerialUnit[]
  inventoryBalances     InventoryBalance[]
  inventoryTransactions InventoryTransaction[]
  inventoryReservations InventoryReservation[]

  @@index([status])
  @@index([sortOrder])
}

model SerialUnit {
  id                 String          @id @default(cuid())
  productId          String
  product            Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId          String?
  variant            ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  warehouseId        String
  warehouse          Warehouse       @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  serialNumber       String          @unique
  condition          String          @default("NEW") // Stable: NEW, LIKE_NEW, USED, OPEN_BOX, REFURBISHED
  status             String          @default("AVAILABLE") // AVAILABLE, RESERVED, ALLOCATED, SOLD, QC_HOLD, REPAIR, DAMAGED, RETURNING, RETURNED
  costPrice          Int?            // Integer VND
  warrantyMonths     Int?
  notes              String?
  allocatedReference String?         // e.g. orderId / orderNumber
  allocatedAt        DateTime?
  receivedAt         DateTime        @default(now())
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  orderItems            OrderItem[]
  inventoryTransactions InventoryTransaction[]
  inventoryReservations InventoryReservation[]

  @@index([productId])
  @@index([variantId])
  @@index([warehouseId])
  @@index([status])
  @@index([condition])
  @@index([warehouseId, status])
  @@index([variantId, status])
}

model InventoryBalance {
  id          String         @id @default(cuid())
  warehouseId String
  warehouse   Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  productId   String
  product     Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId   String
  variant     ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  onHand      Int            @default(0)
  reserved    Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@unique([warehouseId, variantId])
  @@index([productId])
  @@index([variantId])
  @@index([warehouseId])
}

model InventoryTransaction {
  id              String          @id @default(cuid())
  warehouseId     String
  warehouse       Warehouse       @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  productId       String
  product         Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId       String?
  variant         ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  serialUnitId    String?
  serialUnit      SerialUnit?     @relation(fields: [serialUnitId], references: [id], onDelete: SetNull)
  transactionType String          // RECEIVE, ADJUSTMENT, TRANSFER_IN, TRANSFER_OUT, RESERVE, RELEASE, ALLOCATE, SALE, RETURN, DAMAGE
  quantityDelta   Int             // Integer delta (+ or -)
  referenceType   String          // ORDER, PURCHASE, TRANSFER, MANUAL_ADJUSTMENT, RESERVATION
  referenceId     String?
  idempotencyKey  String?         @unique
  actorId         String?
  reason          String?
  balanceBefore   Int?
  balanceAfter    Int?
  createdAt       DateTime        @default(now())

  @@index([warehouseId])
  @@index([productId])
  @@index([variantId])
  @@index([serialUnitId])
  @@index([transactionType])
  @@index([referenceType, referenceId])
  @@index([createdAt])
}

model InventoryReservation {
  id             String         @id @default(cuid())
  warehouseId    String
  warehouse      Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  productId      String
  product        Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId      String
  variant        ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  serialUnitId   String?
  serialUnit     SerialUnit?    @relation(fields: [serialUnitId], references: [id], onDelete: SetNull)
  quantity       Int            @default(1)
  referenceType  String         // CHECKOUT, ORDER, MANUAL_HOLD
  referenceId    String
  status         String         @default("ACTIVE") // ACTIVE, COMMITTED, RELEASED, EXPIRED, CANCELLED
  expiresAt      DateTime
  idempotencyKey String?        @unique
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([warehouseId])
  @@index([variantId])
  @@index([serialUnitId])
  @@index([status])
  @@index([expiresAt])
  @@index([referenceType, referenceId])
}

model ContactSubmission {
  id        String   @id @default(cuid())
  name      String
  phone     String
  email     String?
  message   String?
  status    String   @default("PENDING") // PENDING, PROCESSED
  ipHash    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  internalNote String?
  handledAt DateTime?
  handledBy String?
  revision  Int      @default(1)
  startedProcessingAt DateTime?
  events    ContactEvent[]

  @@index([status])
  @@index([createdAt])
}

model ContactEvent {
  id         String            @id @default(cuid())
  contactId  String
  contact    ContactSubmission @relation(fields: [contactId], references: [id], onDelete: Cascade)
  action     String            // STATUS_CHANGE, NOTE_ADDED
  fromStatus String?
  toStatus   String?
  note       String?
  actor      String            @default("Admin vận hành (Phiên dùng chung)")
  createdAt  DateTime          @default(now())

  @@index([contactId])
  @@index([createdAt])
}

model AdminNotification {
  id          String    @id @default(cuid())
  type        String    // NEW_ORDER, ORDER_STATUS_CHANGED, NEW_CONTACT
  referenceId String
  title       String
  message     String
  isRead      Boolean   @default(false)
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  @@unique([type, referenceId])
  @@index([isRead])
  @@index([createdAt])
}

model RateLimitRecord {
  key       String   @id
  count     Int      @default(1)
  expiresAt DateTime

  @@index([expiresAt])
}

// ADMIN-04: one versioned aggregate; categories project to existing Category on publish.
model NavigationStudio {
  id String @id
  revision Int @default(0)
  draft String
  published String?
  publishedRevision Int?
  updatedAt String @default(dbgenerated("CURRENT_TIMESTAMP"))
}

model NavigationRevision {
  revision Int @id
  document String
  action String
  actor String @default("admin")
  createdAt String @default(dbgenerated("CURRENT_TIMESTAMP"))
}

model ProductStudio {
  productId String @id
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  revision Int @default(0)
  draft String
  published String?
  updatedAt DateTime @default(now())
  revisions ProductStudioRevision[]
}

model ProductStudioRevision {
  productId String
  studio ProductStudio @relation(fields: [productId], references: [productId], onDelete: Restrict)
  revision Int
  document String
  action String
  createdAt DateTime @default(now())
  @@id([productId, revision])
}

// CMS registry; ProductImage relations are tracked by migration 0009 triggers.
model MediaAsset {
  id         String @id
  kind       String
  provider   String
  storageKey String? @unique
  externalId String?
  name       String
  alt        String @default("")
  caption    String @default("")
  mimeType   String?
  size       Int?
  width      Int?
  height     Int?
  revision   Int @default(1)
  state      String @default("READY")
  createdAt  String @default(dbgenerated("(strftime('%Y-%m-%dT%H:%M:%fZ','now'))"))
  updatedAt  String @default(dbgenerated("(strftime('%Y-%m-%dT%H:%M:%fZ','now'))"))
  usages     MediaUsage[]

  @@unique([provider, externalId])
  @@index([state, createdAt])
}

model MediaUsage {
  id        String @id
  assetId   String
  asset     MediaAsset @relation(fields: [assetId], references: [id], onDelete: Restrict)
  ownerType String
  ownerId   String
  slot      String
  createdAt String @default(dbgenerated("(strftime('%Y-%m-%dT%H:%M:%fZ','now'))"))

  @@unique([assetId, ownerType, ownerId, slot])
  @@index([ownerType, ownerId], map: "MediaUsage_owner_idx")
  @@index([assetId])
}

model SiteSettings {
  id        String   @id @default("site")
  revision  Int      @default(0)
  document  String
  updatedAt DateTime @default(now())
}

model SiteSettingsRevision {
  revision  Int      @id
  document  String
  action    String
  actor     String   @default("admin")
  createdAt DateTime @default(now())
}


// R05 content foundation; migration 0014_content_cms.sql.
// Article categories are independent from product Category by business requirement.
model PostCategory {
  revision Int @default(1)
  id String @id
  name String
  slug String @unique
  sortOrder Int @default(0)
  status String @default("ACTIVE")
  createdAt String @default(dbgenerated("CURRENT_TIMESTAMP"))
  updatedAt String @default(dbgenerated("CURRENT_TIMESTAMP"))
  posts Post[]
}

// Post identity only; editorial fields (title, excerpt, body, SEO, relatedProductIds...)
// live in PostStudio.draft/published JSON, same shape as ProductStudio.
model Post {
  id String @id
  slug String @unique
  categoryId String?
  category PostCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdAt String @default(dbgenerated("CURRENT_TIMESTAMP"))
  updatedAt String @default(dbgenerated("CURRENT_TIMESTAMP"))
  deletedAt String?
  studio PostStudio?
}

model PostStudio {
  publishedRevision Int?
  publishedAt String?
  publicUpdatedAt String?
  postId String @id
  post Post @relation(fields: [postId], references: [id], onDelete: Restrict)
  revision Int @default(0)
  draft String
  published String?
  updatedAt String @default(dbgenerated("CURRENT_TIMESTAMP"))
  revisions PostStudioRevision[]
}

model PostStudioRevision {
  postId String
  studio PostStudio @relation(fields: [postId], references: [postId], onDelete: Restrict)
  revision Int
  document String
  action String
  actor String @default("admin")
  createdAt String @default(dbgenerated("CURRENT_TIMESTAMP"))
  @@id([postId, revision])
}

// Static/system pages (warranty, returns, shipping, about, stores...).
model Page {
  id String @id
  slug String @unique
  pageType String?
  createdAt String @default(dbgenerated("CURRENT_TIMESTAMP"))
  updatedAt String @default(dbgenerated("CURRENT_TIMESTAMP"))
  deletedAt String?
  studio PageStudio?
}

model PageStudio {
  publishedRevision Int?
  publishedAt String?
  publicUpdatedAt String?
  pageId String @id
  page Page @relation(fields: [pageId], references: [id], onDelete: Restrict)
  revision Int @default(0)
  draft String
  published String?
  updatedAt String @default(dbgenerated("CURRENT_TIMESTAMP"))
  revisions PageStudioRevision[]
}

model PageStudioRevision {
  pageId String
  studio PageStudio @relation(fields: [pageId], references: [pageId], onDelete: Restrict)
  revision Int
  document String
  action String
  actor String @default("admin")
  createdAt String @default(dbgenerated("CURRENT_TIMESTAMP"))
  @@id([pageId, revision])
}

// R07A Site Builder: Structured Page Builder for Homepage and Landing Pages.
model LandingPage {
  id        String   @id
  slug      String
  isHome    Int      @default(0)
  name      String
  status    String   @default("DRAFT")
  createdAt String   @default(dbgenerated("CURRENT_TIMESTAMP"))
  updatedAt String   @default(dbgenerated("CURRENT_TIMESTAMP"))
  deletedAt String?
  studio    LandingPageStudio?

  @@index([status])
  @@index([isHome])
}

model LandingPageStudio {
  pageId            String      @id
  page              LandingPage @relation(fields: [pageId], references: [id], onDelete: Restrict)
  publishedRevision Int?
  publishedAt       String?
  publicUpdatedAt   String?
  revision          Int         @default(0)
  draft             String
  published         String?
  updatedAt         String      @default(dbgenerated("CURRENT_TIMESTAMP"))
  revisions         LandingPageRevision[]
}

model LandingPageRevision {
  pageId    String
  studio    LandingPageStudio @relation(fields: [pageId], references: [pageId], onDelete: Restrict)
  revision  Int
  document  String
  action    String
  actor     String   @default("admin")
  createdAt String   @default(dbgenerated("CURRENT_TIMESTAMP"))

  @@id([pageId, revision])
}

