generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id         String   @id @default(cuid())
  email      String   @unique
  password   String
  name       String?
  phone      String?
  role       String   @default("USER") // USER, ADMIN
  tier       String   @default("Mới") // Vàng, Bạc, Mới
  totalSpend Float    @default(0)
  orders     Order[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Category {
  id            String     @id @default(cuid())
  name          String     @unique
  slug          String     @unique
  parentId      String?
  parent        Category?  @relation("CategoryToCategory", fields: [parentId], references: [id])
  subCategories Category[] @relation("CategoryToCategory")
  products      Product[]
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

model Product {
  id            String   @id @default(cuid())
  name          String
  slug          String   @unique
  description   String
  price         Float
  originalPrice Float?
  images        String   // JSON string or comma-separated
  stock         Int      @default(0)
  status        String   @default("active") // active, draft, archived
  specs         String?  // JSON string for specs
  tags          String?  // Comma-separated string
  categoryId    String
  category      Category @relation(fields: [categoryId], references: [id])
  orderItems    OrderItem[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Order {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  status          String   @default("Chờ xác nhận") // Chờ xác nhận, Đang xử lý, Đang vận chuyển, Đã hoàn thành, Đã hủy
  totalAmount     Float
  shippingAddress String?
  paymentMethod   String   @default("COD") // COD, Chuyển khoản, Thẻ tín dụng
  paymentStatus   String   @default("Chưa thanh toán") // Chưa thanh toán, Đã thanh toán, Đã hoàn tiền
  items           OrderItem[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  quantity  Int
  price     Float    // Price at the time of purchase
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
